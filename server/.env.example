NODE_ENV=development
PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/recoveryos

# LLM — provider: gemini | ollama | rules (rules = deterministic fallback, no network)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

GEMINI_API_KEY=replace-with-your-key

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Execution layer — simulator | razorpay_test
# razorpay_test sends create_payment_link actions to the REAL Razorpay
# Payment Links API using TEST keys (no real money). Other actions stay simulated.
EXECUTION_PROVIDER=simulator

# Razorpay TEST keys (Dashboard → Settings → API Keys → Test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret (Dashboard → Settings → Webhooks). Required for the
# /api/webhooks/razorpay endpoint to accept events.
RAZORPAY_WEBHOOK_SECRET=

CLIENT_URL=http://localhost:5173
